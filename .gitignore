# Built application files
*.apk
*.aar.tmp
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/
app/build/

# Local configuration file (sdk path, API keys, etc.) — NEVER commit
local.properties

# Android Studio / IntelliJ
*.iml
.idea/
captures/
.externalNativeBuild/
.cxx/

# Keystore files
*.jks
*.keystore

# macOS
.DS_Store

# Diagnostic audio dumps
diag_audio.*

# Model weights — large binaries, kept out of git (distribute separately)
*.onnx
*.tflite
# EXCEPTION: the YOLOv8 detector GRAPH is only 292KB (the 12MB weights live in the
# tracked .data file next to it). ONNX external-data needs BOTH files at runtime, so the
# default YOLO_QNN_EP detector — and thus a fresh-clone build — is unbootable without it.
!app/src/main/assets/detect/qnn/yolov8_det.onnx
app/src/main/assets/model/
models/

# Sherpa-ONNX streaming model — large, distribute separately
app/src/main/assets/sherpa/

# Sherpa-ONNX Android AAR — 56MB (>50MB), fetch manually from
# https://github.com/k2-fsa/sherpa-onnx/releases (sherpa-onnx-1.13.2.aar) into libs/
libs/sherpa-onnx-*.aar
app/libs/sherpa-onnx-*.aar

# bge-small text-embedding model — distribute separately
app/src/main/assets/bge/

# VAD + Moonshine offline ASR models — distribute separately
app/src/main/assets/vad/
app/src/main/assets/moonshine/
_unused_models/
.firecrawl/
