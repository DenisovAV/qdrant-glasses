# Built application files
*.apk
*.aar.tmp
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/
app/build/

# Local configuration file (sdk path, API keys, etc.) — NEVER commit
local.properties

# Android Studio / IntelliJ
*.iml
.idea/
captures/
.externalNativeBuild/
.cxx/

# Keystore files
*.jks
*.keystore

# macOS
.DS_Store

# Diagnostic audio dumps
diag_audio.*

# Model weights — large binaries, kept out of git (distribute separately)
*.onnx
*.tflite
app/src/main/assets/model/
models/

# Sherpa-ONNX streaming model — large, distribute separately
app/src/main/assets/sherpa/

# Sherpa-ONNX Android AAR — 56MB (>50MB), fetch manually from
# https://github.com/k2-fsa/sherpa-onnx/releases (sherpa-onnx-1.13.2.aar) into libs/
libs/sherpa-onnx-*.aar
app/libs/sherpa-onnx-*.aar

# bge-small text-embedding model — distribute separately
app/src/main/assets/bge/
