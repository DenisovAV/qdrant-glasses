# Built application files
*.apk
*.aar.tmp
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/
app/build/

# Local configuration file (sdk path, API keys, etc.) — NEVER commit
local.properties

# Android Studio / IntelliJ
*.iml
.idea/
captures/
.externalNativeBuild/
.cxx/

# Keystore files
*.jks
*.keystore

# macOS
.DS_Store

# Diagnostic audio dumps
diag_audio.*

# Model weights — large binaries, kept out of git (distribute separately)
*.onnx
*.tflite
app/src/main/assets/model/
models/

# Sherpa-ONNX streaming model — large, distribute separately
app/src/main/assets/sherpa/

# Sherpa-ONNX Android AAR — ~36MB, fetch manually from
# https://github.com/k2-fsa/sherpa-onnx/releases into libs/
# (we use the static-link build: sherpa-onnx-static-link-onnxruntime-<ver>.aar — it has ORT linked
# in, so it ships no standalone libonnxruntime.so on arm64 to clash with the Maven ORT we use.)
libs/sherpa-onnx-*.aar
app/libs/sherpa-onnx-*.aar

# bge-small text-embedding model — distribute separately
app/src/main/assets/bge/

# VAD + Moonshine offline ASR models — distribute separately
app/src/main/assets/vad/
app/src/main/assets/moonshine/
_unused_models/
.firecrawl/

# docs/ is where this project's internal writing accumulates: working drafts, our own code-review
# findings, dev-process specs and plans, and point-in-time code analyses. All of it is written for
# ourselves, and it rots — the risk map that lived here still listed as open several bugs fixed
# months earlier. README.md is the account that is maintained and meant to be read.
# Kept outside the working tree; the whole directory stays out of git.
docs/
slides/personal_memory_speaker_plan.md

# Real camera frames from demo sessions — photographs of a private space. The deck's thumbnail rail
# and its rendered screenshots both embedded them, so both are excluded: deleting only the JPEGs
# would have published the photographs anyway, baked into the PNGs.
slides/img/
slides/screenshots/

# int8 YOLOv8n QNN graph + external weights. NOT committed: YOLOv8 is Ultralytics AGPL-3.0, and
# vendoring its weights would push AGPL onto this whole repository. README has the qai-hub export
# command that reproduces both files.
app/src/main/assets/detect/qnn/

# The Qdrant Edge AARs (app/libs/*.aar) ARE committed — Apache-2.0, same as this repo. See NOTICE.
# The sherpa-onnx AAR in the root libs/ is not: it is a large public release, fetched (see README).

# Conference slides — presentation material, not part of the app. Lives with the talk, not here.
slides/
.kotlin/
