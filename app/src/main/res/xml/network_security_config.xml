<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The crop-embedding endpoint is the user's own Mac, reached over USB via
         `adb reverse tcp:9000` as http://localhost:9000 — plain HTTP, no TLS.
         Android 9+ blocks cleartext by default, so allow it for loopback only.
         Everything else stays cleartext-forbidden. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
