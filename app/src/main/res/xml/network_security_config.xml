<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The Mac serves crop-embedding AND (wireless mode) the MJPEG/HUD relay over plain HTTP.
         The relay URL is overridable at runtime (setprop debug.qdrant.relay, see Config) so the
         Mac's IP is whatever the venue/hotspot network hands out — we can't whitelist a fixed
         address. This is a demo device that only ever talks to our own relay on a private LAN,
         so allow cleartext globally instead of pinning per-IP. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
